<roblox version="4">
  <Item class="Script" referent="0">
    <Properties>
      <string name="Name">Leaderboards</string>
      <token name="RunContext">0</token>
      <string name="Source"><![CDATA[--!strict
-- Topki w miejscu modeli "Leaderboard" / "Leadboard" w Workspace.
-- Biały model to znacznik miejsca: po starcie gry powstaje w nim drewniana tablica
-- (BoardBuilder), a znacznik jest usuwany. Ustaw REPLACE_MARKERS = false, jeśli model ma zostać.
-- Atrybuty na modelu (opcjonalne):
--   Stat  = "Wins"        statystyka z PlayerStats.StatNames
--   Rows  = 10            liczba miejsc
--   Title = "TOP WINS"    tytuł
--   Face  = "Front"       strona części z ekranem (domyślnie obie duże strony)
-- Ekranem jest część o nazwie Board/Screen/Display/Sign/Surface albo z atrybutem
-- LeaderboardSurface = true; bez tego największa część modelu.

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local UserService = game:GetService("UserService")
local Workspace = game:GetService("Workspace")

local PlayerStats = require(ServerScriptService:WaitForChild("PlayerStats"))
local BoardBuilder = require(script.BoardBuilder)

local REFRESH_INTERVAL = 60
local REPLACE_MARKERS = true
local DEFAULT_ROWS = 10
local MODEL_PATTERN = "^leade?r?board"
local SURFACE_NAMES = { board = true, screen = true, display = true, sign = true, surface = true }

-- Paleta mapy FARMHOUSE.
local WOOD_DARK = Color3.fromRGB(58, 36, 20)
local WOOD = Color3.fromRGB(122, 80, 48)
local WOOD_LIGHT = Color3.fromRGB(140, 94, 58)
local BARN_RED = Color3.fromRGB(184, 58, 52)
local TRIM = Color3.fromRGB(246, 238, 222)
local PUMPKIN = Color3.fromRGB(255, 166, 48)
local WHITE = Color3.new(1, 1, 1)
local RANK_COLORS = {
	Color3.fromRGB(255, 200, 30), -- złoto
	Color3.fromRGB(206, 210, 220), -- srebro
	Color3.fromRGB(205, 127, 50), -- brąz
}
local TITLE_FONT = Enum.Font.SpecialElite

type Row = { Root: Frame, Rank: TextLabel, Avatar: ImageLabel, Name: TextLabel, Value: TextLabel }
type Screen = { Rows: { Row }, Footer: TextLabel }
type Board = { Model: Model, Stat: string, RowCount: number, Screens: { Screen } }
type Entry = { UserId: number, Value: number }

local boards: { Board } = {}
local nameCache: { [number]: string } = {}

local function create(className: string, props: { [string]: any }, children: { any }?): any
	local instance = Instance.new(className)
	for name, value in props do
		if name ~= "Parent" then
			(instance :: any)[name] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

local function corner(scale: number): UICorner
	return create("UICorner", { CornerRadius = UDim.new(scale, 0) })
end

local function label(props: { [string]: any }): TextLabel
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextScaled = true
	props.TextColor3 = props.TextColor3 or WHITE
	return create("TextLabel", props, { create("UIStroke", { Thickness = 3, Transparency = 0.15 }) })
end

local function abbreviate(value: number): string
	if value >= 1e6 then
		return string.format("%.1fM", value / 1e6)
	elseif value >= 1e4 then
		return string.format("%.1fK", value / 1e3)
	end
	return tostring(value)
end

-- Budowanie planszy ----------------------------------------------------------

local function buildRow(parent: Instance, index: number, rowCount: number): Row
	local root = create("Frame", {
		Name = `Row{index}`,
		LayoutOrder = index,
		Size = UDim2.new(1, 0, 1 / rowCount, -6),
		BackgroundColor3 = if index % 2 == 1 then WOOD_LIGHT else WOOD,
		Parent = parent,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0.2, 0) }),
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0.015, 0),
		}),
		create("UIPadding", { PaddingLeft = UDim.new(0.015, 0), PaddingRight = UDim.new(0.03, 0) }),
	})
	local rank = label({
		Name = "Rank",
		LayoutOrder = 1,
		Text = tostring(index),
		Font = Enum.Font.FredokaOne,
		Size = UDim2.fromScale(0.82, 0.82),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundTransparency = 0,
		BackgroundColor3 = RANK_COLORS[index] or WOOD_DARK,
		Parent = root,
	})
	corner(1).Parent = rank
	create("UIPadding", { PaddingTop = UDim.new(0.15, 0), PaddingBottom = UDim.new(0.15, 0) }).Parent = rank
	local avatar = create("ImageLabel", {
		Name = "Avatar",
		LayoutOrder = 2,
		Size = UDim2.fromScale(0.82, 0.82),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundColor3 = WOOD_DARK,
		Parent = root,
	}, { corner(0.25) })
	local name = label({
		Name = "PlayerName",
		LayoutOrder = 3,
		Font = TITLE_FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.fromScale(0.5, 0.62),
		Parent = root,
	})
	create("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }).Parent = name
	local value = label({
		Name = "Value",
		LayoutOrder = 4,
		Font = Enum.Font.FredokaOne,
		TextColor3 = PUMPKIN,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.fromScale(0.2, 0.62),
		Parent = root,
	})
	return { Root = root, Rank = rank, Avatar = avatar, Name = name, Value = value }
end

local function buildScreen(part: BasePart, face: Enum.NormalId, title: string, rowCount: number): Screen
	local gui = create("SurfaceGui", {
		Name = `LeaderboardGui_{face.Name}`,
		Face = face,
		Adornee = part,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 50,
		LightInfluence = 0,
		MaxDistance = 200,
		ClipsDescendants = true,
		Parent = part,
	})
	local frame = create("Frame", {
		Name = "Frame",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WOOD_DARK,
		Parent = gui,
	}, {
		create("UIPadding", {
			PaddingTop = UDim.new(0.025, 0),
			PaddingBottom = UDim.new(0.02, 0),
			PaddingLeft = UDim.new(0.03, 0),
			PaddingRight = UDim.new(0.03, 0),
		}),
	})

	-- Nagłówek: czerwona deska stodoły z białym obramowaniem.
	local header = create("Frame", {
		Name = "Header",
		Size = UDim2.fromScale(1, 0.15),
		BackgroundColor3 = BARN_RED,
		Parent = frame,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0.18, 0) }),
		create("UIStroke", { Thickness = 6, Color = TRIM, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	})
	label({
		Name = "Title",
		Text = `🏆 {title} 🏆`,
		Font = TITLE_FONT,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.94, 0.78),
		Parent = header,
	})

	local list = create("Frame", {
		Name = "Rows",
		Position = UDim2.fromScale(0, 0.19),
		Size = UDim2.fromScale(1, 0.73),
		BackgroundTransparency = 1,
		Parent = frame,
	}, {
		create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		}),
	})
	local rows = {}
	for index = 1, rowCount do
		table.insert(rows, buildRow(list, index, rowCount))
	end

	local footer = label({
		Name = "Footer",
		Text = "Loading...",
		Font = TITLE_FONT,
		TextColor3 = TRIM,
		Position = UDim2.fromScale(0, 0.935),
		Size = UDim2.fromScale(1, 0.065),
		Parent = frame,
	})
	return { Rows = rows, Footer = footer }
end

local function findSurfacePart(model: Model): BasePart?
	local largest: BasePart? = nil
	local largestArea = 0
	for _, descendant in model:GetDescendants() do
		if not descendant:IsA("BasePart") then
			continue
		end
		if descendant:GetAttribute("LeaderboardSurface") == true or SURFACE_NAMES[string.lower(descendant.Name)] then
			return descendant
		end
		local size = descendant.Size
		local dims = { size.X, size.Y, size.Z }
		table.sort(dims)
		local area = dims[2] * dims[3]
		if area > largestArea then
			largest, largestArea = descendant, area
		end
	end
	return largest
end

-- Ekran na dwóch dużych ścianach części (oś najcieńsza), chyba że atrybut Face mówi inaczej.
local function screenFaces(model: Model, part: BasePart): { Enum.NormalId }
	local faceName = model:GetAttribute("Face")
	if typeof(faceName) == "string" then
		for _, face in Enum.NormalId:GetEnumItems() do
			if face.Name == faceName then
				return { face }
			end
		end
	end
	local size = part.Size
	if size.X <= size.Y and size.X <= size.Z then
		return { Enum.NormalId.Right, Enum.NormalId.Left }
	elseif size.Y <= size.Z then
		return { Enum.NormalId.Top, Enum.NormalId.Bottom }
	end
	return { Enum.NormalId.Front, Enum.NormalId.Back }
end

local function register(instance: Instance)
	if not instance:IsA("Model") or not string.find(string.lower(instance.Name), MODEL_PATTERN) then
		return
	end
	for _, board in boards do
		if board.Model == instance or instance:IsDescendantOf(board.Model) then
			return
		end
	end

	if not instance:FindFirstChildWhichIsA("BasePart", true) then
		warn(`[Leaderboard] {instance:GetFullName()} has no parts, cannot tell where the board goes.`)
		return
	end
	local parent = instance.Parent
	local model = instance
	if REPLACE_MARKERS and not BoardBuilder.IsBuilt(instance) then
		model = BoardBuilder.Build(instance)
	end
	local part = findSurfacePart(model)
	if not part then
		return
	end
	local statAttribute = model:GetAttribute("Stat")
	local stat = if typeof(statAttribute) == "string" then statAttribute else "Wins"
	if not PlayerStats.GetOrderedStore(stat) then
		warn(`[Leaderboard] Unknown stat "{stat}" on {model.Name}, add it to PlayerStats.StatNames.`)
		model.Parent = parent
		return
	end
	local rowsAttribute = model:GetAttribute("Rows")
	local rowCount = math.clamp(if typeof(rowsAttribute) == "number" then math.floor(rowsAttribute) else DEFAULT_ROWS, 3, 25)
	local titleAttribute = model:GetAttribute("Title")
	local title = if typeof(titleAttribute) == "string" then titleAttribute else `TOP {string.upper(stat)}`

	local screens = {}
	for _, face in screenFaces(model, part) do
		table.insert(screens, buildScreen(part, face, title, rowCount))
	end
	table.insert(boards, { Model = model, Stat = stat, RowCount = rowCount, Screens = screens })
	model.Parent = parent
	print(`[Leaderboard] Registered {model:GetFullName()} (stat: {stat}, surface: {part.Name}).`)
end

-- Dane -----------------------------------------------------------------------

local function resolveNames(entries: { Entry })
	local missing = {}
	for _, entry in entries do
		if not nameCache[entry.UserId] then
			local player = Players:GetPlayerByUserId(entry.UserId)
			if player then
				nameCache[entry.UserId] = player.DisplayName
			else
				table.insert(missing, entry.UserId)
			end
		end
	end
	if #missing == 0 then
		return
	end
	local ok, infos = pcall(function()
		return UserService:GetUserInfosByUserIdsAsync(missing)
	end)
	if ok then
		for _, info in infos do
			nameCache[info.Id] = info.DisplayName
		end
	end
	for _, userId in missing do
		if not nameCache[userId] then
			local found, name = pcall(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			nameCache[userId] = if found then name else `Player {userId}`
		end
	end
end

local function fetch(stat: string, count: number): { Entry }?
	local orderedStore = PlayerStats.GetOrderedStore(stat)
	if not orderedStore then
		return nil
	end
	local ok, pages = pcall(function()
		return orderedStore:GetSortedAsync(false, count, 1)
	end)
	if not ok then
		warn(`[Leaderboard] Could not load {stat}:`, pages)
		return nil
	end
	local entries = {}
	for _, item in pages:GetCurrentPage() do
		local userId = tonumber(item.key)
		if userId then
			table.insert(entries, { UserId = userId, Value = item.value })
		end
	end
	resolveNames(entries)
	return entries
end

local function render(board: Board, entries: { Entry })
	for _, screen in board.Screens do
		for index, row in screen.Rows do
			local entry = entries[index]
			row.Root.BackgroundTransparency = if entry then 0 else 0.45
			if entry then
				row.Name.Text = nameCache[entry.UserId] or "..."
				row.Value.Text = abbreviate(entry.Value)
				row.Avatar.Image = `rbxthumb://type=AvatarHeadShot&id={entry.UserId}&w=150&h=150`
			else
				row.Name.Text = if index == 1 then "Be the first!" else "---"
				row.Value.Text = ""
				row.Avatar.Image = ""
			end
		end
	end
end

local function setFooter(text: string)
	for _, board in boards do
		for _, screen in board.Screens do
			screen.Footer.Text = text
		end
	end
end

local function refresh()
	local needed: { [string]: number } = {}
	for _, board in boards do
		needed[board.Stat] = math.max(needed[board.Stat] or 0, board.RowCount)
	end
	for stat, count in needed do
		local entries = fetch(stat, count)
		if entries then
			for _, board in boards do
				if board.Stat == stat then
					render(board, entries)
				end
			end
		end
	end
end

for _, instance in Workspace:GetDescendants() do
	register(instance)
end
Workspace.DescendantAdded:Connect(register)

if #boards == 0 then
	warn("[Leaderboard] No Leaderboard models found in Workspace.")
end

while true do
	refresh()
	for secondsLeft = REFRESH_INTERVAL, 1, -1 do
		setFooter(`Updates in {secondsLeft}s`)
		task.wait(1)
	end
end
]]></string>
    </Properties>
    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">BoardBuilder</string>
        <string name="Source"><![CDATA[--!strict
-- Zamienia znacznik (biały model "Leaderboard") na drewnianą tablicę w stylu farmy:
-- dwa słupy, deska z topką, belki, czerwony daszek i dynie u podstawy. Znacznik jest usuwany.
-- Tablica ma szerokość i wysokość znacznika, stoi na jego spodzie i jest obrócona wzdłuż
-- jego dłuższego boku.

local BoardBuilder = {}

-- Kolory: zmień tutaj, żeby dopasować tablicę do mostu / reszty mapy.
local POST = Color3.fromRGB(92, 62, 40)
local PLANKS = Color3.fromRGB(125, 84, 52)
local BEAM = Color3.fromRGB(70, 45, 28)
local ROOF = Color3.fromRGB(156, 48, 42)
local TRIM = Color3.fromRGB(246, 238, 222)
local PUMPKIN = Color3.fromRGB(235, 128, 30)
local STEM = Color3.fromRGB(76, 110, 40)

local MIN_WIDTH, MAX_WIDTH = 8, 30
local MIN_HEIGHT, MAX_HEIGHT = 9, 30
local ROOF_ANGLE = math.rad(32)

local function part(model: Model, props: { [string]: any }): Part
	local newPart = Instance.new("Part")
	newPart.Anchored = true
	newPart.Material = Enum.Material.Wood
	newPart.TopSurface = Enum.SurfaceType.Smooth
	newPart.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(newPart :: any)[key] = value
	end
	newPart.Parent = model
	return newPart
end

function BoardBuilder.IsBuilt(model: Model): boolean
	return model:GetAttribute("LeaderboardBuilt") == true
end

-- Buduje tablicę w miejscu znacznika. Zwraca nowy model bez rodzica (parentuje wywołujący).
function BoardBuilder.Build(marker: Model): Model
	local boxCFrame, boxSize = marker:GetBoundingBox()

	-- Oś wzdłuż tablicy = dłuższy poziomy bok znacznika.
	local along = if boxSize.X >= boxSize.Z then boxCFrame.RightVector else boxCFrame.LookVector
	along = Vector3.new(along.X, 0, along.Z)
	along = if along.Magnitude > 0.01 then along.Unit else Vector3.xAxis
	local ground = boxCFrame.Position - Vector3.new(0, boxSize.Y / 2, 0)
	local base = CFrame.fromMatrix(ground, along, Vector3.yAxis)
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end

	local width = math.clamp(math.max(boxSize.X, boxSize.Z), MIN_WIDTH, MAX_WIDTH)
	local height = math.clamp(boxSize.Y, MIN_HEIGHT, MAX_HEIGHT)
	local boardBottom, boardTop = height * 0.12, height * 0.84

	local model = Instance.new("Model")
	model.Name = marker.Name
	for name, value in marker:GetAttributes() do
		model:SetAttribute(name, value)
	end
	model:SetAttribute("LeaderboardBuilt", true)

	-- Słupy
	for _, side in { -1, 1 } do
		part(model, {
			Name = "Post",
			Size = Vector3.new(0.9, height * 0.95, 0.9),
			CFrame = at(side * width / 2, height * 0.475, 0),
			Color = POST,
		})
	end

	-- Deska z topką (na niej jest SurfaceGui)
	local board = part(model, {
		Name = "Board",
		Size = Vector3.new(width - 0.9, boardTop - boardBottom, 0.35),
		CFrame = at(0, (boardBottom + boardTop) / 2, 0),
		Color = PLANKS,
		Material = Enum.Material.WoodPlanks,
	})

	-- Belki nad i pod deską
	part(model, {
		Name = "TopBeam",
		Size = Vector3.new(width + 0.9, 0.7, 0.8),
		CFrame = at(0, boardTop + 0.35, 0),
		Color = BEAM,
	})
	part(model, {
		Name = "BottomBeam",
		Size = Vector3.new(width + 0.9, 0.6, 0.8),
		CFrame = at(0, boardBottom - 0.3, 0),
		Color = BEAM,
	})

	-- Dwuspadowy daszek jak na stodole
	local roofDepth = 1.8
	local peak = boardTop + 0.7 + math.sin(ROOF_ANGLE) * roofDepth
	for _, side in { -1, 1 } do
		part(model, {
			Name = "Roof",
			Size = Vector3.new(width + 2.2, 0.35, roofDepth),
			CFrame = at(0, peak, 0)
				* CFrame.Angles(side * ROOF_ANGLE, 0, 0)
				* CFrame.new(0, 0, side * roofDepth / 2),
			Color = ROOF,
			Material = Enum.Material.WoodPlanks,
		})
	end
	part(model, {
		Name = "RoofRidge",
		Size = Vector3.new(width + 2.4, 0.35, 0.35),
		CFrame = at(0, peak + 0.15, 0),
		Color = TRIM,
	})

	-- Dynie u podstawy
	for _, pumpkin in { { x = -1, size = 1.8 }, { x = 1, size = 1.3 } } do
		local position = at(pumpkin.x * (width / 2 + 1.3), pumpkin.size * 0.42, -0.6)
		part(model, {
			Name = "Pumpkin",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(pumpkin.size, pumpkin.size * 0.85, pumpkin.size),
			CFrame = position,
			Color = PUMPKIN,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
		part(model, {
			Name = "Stem",
			Size = Vector3.new(0.2, 0.45, 0.2),
			CFrame = position * CFrame.new(0, pumpkin.size * 0.45, 0),
			Color = STEM,
			CanCollide = false,
		})
	end

	model.PrimaryPart = board
	marker:Destroy()
	return model
end

return BoardBuilder
]]></string>
      </Properties>
    </Item>
  </Item>
</roblox>